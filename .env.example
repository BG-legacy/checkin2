# Copy this file to .env and fill in the values from your Supabase project.
# Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Password for the results dashboard at /#/results.
# Note: this is bundled into the client JS, so don't reuse a real password.
VITE_ANALYTICS_PASSWORD=HCI-2026
